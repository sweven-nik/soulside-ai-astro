{items3.map((item2) => (<div data-wf-id="9450370c-0cf9-c3e5-5045-a507fa891fd1" data-w-id="9450370c-0cf9-c3e5-5045-a507fa891fd1" class="w-dyn-item resources-item"><ElementBlogCard mainImage={item2.fields["main-image"]} linkTarget={linkTarget(evaluate(bindings[3], { data, Dynamo: item2.fields }))} link={linkUrl(evaluate(bindings[2], { data, Dynamo: item2.fields }))}>
