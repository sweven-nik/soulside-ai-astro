import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const entries = await getCollection("resource");
  const slugs = new Set();
  return entries.filter(e => !e.data.isDraft && !e.data.isArchived).map(entry => {
    const slug = entry.id;
    if (!slug || /[\/\\]|^\.{1,2}$/.test(slug) || slugs.has(slug)) throw new Error('Invalid or duplicate CMS slug: ' + slug);
    slugs.add(slug);
    return { params: { slug }, props: { entry } };
  });
}
const data = {};
const collectionData = resolveAssetUrls({ ...Astro.props.entry.data, slug: Astro.props.entry.id, fullSlug: "/resource/" + Astro.props.entry.id, ...Object.fromEntries(Object.entries(Astro.props.entry.data._imageAlts ?? {}).map(([key, alt]) => [key, { url: Astro.props.entry.data[key], alt }])) });
const collections = {
  "resource": (await getCollection("resource")).filter(entry => !entry.data.isDraft && !entry.data.isArchived).map(entry => ({id: entry.data._id ?? entry.id, fields: resolveAssetUrls({ ...entry.data, slug: entry.id, fullSlug: "/resource/" + entry.id, ...Object.fromEntries(Object.entries(entry.data._imageAlts ?? {}).map(([key, alt]) => [key, { url: entry.data[key], alt }])) })}))
};
const items1 = [...collections["resource"]].filter(entry => { const value0 = entry.fields?.["_id"]; let expected0 = "DYN_CONTEXT"; if (typeof value0 === 'boolean' && ['true', 'false'].includes(expected0)) expected0 = expected0 === 'true'; if (typeof value0 === 'number' && typeof expected0 === 'string' && expected0.trim() !== '' && Number.isFinite(Number(expected0))) expected0 = Number(expected0); return (value0 !== expected0); }).sort((a, b) => { const x = a.fields["publish-date"], y = b.fields["publish-date"]; return (x === y ? 0 : x == null ? -1 : y == null ? 1 : typeof x === 'number' && typeof y === 'number' ? x - y : String(x).localeCompare(String(y))) * -1; });
---
<Layout webflowPageId="6abe9af376a33690663b8d3d" pageTitle={(collectionData.name ?? "") + " | Soulside AI"} pageDescription={(collectionData["post-summary"] ?? "")} data-wf-id="6a98fc634cb744f81e93ec47" data-w-id="6a98fc634cb744f81e93ec47">
<div data-wf-id="df52569a-3b7c-d9be-4cf4-0c80b46c06e0" data-w-id="df52569a-3b7c-d9be-4cf4-0c80b46c06e0" class="page-wrapper">
<GlobalEmbeds />
<GlobalAnnouncementBar />
<GlobalNavbar />
<div data-wf-id="2b0b05d2-b1c5-c31f-c9b6-8384f27cb1c5" data-w-id="2b0b05d2-b1c5-c31f-c9b6-8384f27cb1c5" class="main-wrapper">
<Section sectionContainer="small">
<ElementContentGroup buttonGroupVisibility={false} bodyVisibility={false} headingStyle="h2" headingTag="h1">
<Fragment slot="headingtext">{collectionData.name ?? ""}</Fragment>
<Fragment slot="taglinetext">{text(formatDate(collectionData["publish-date"], "MMMM D, YYYY"))}</Fragment>
</ElementContentGroup>
<ElementImage imageBorderRadius="medium" imageAspectRatio="widescreen-16x9" imageFile={collectionData["main-image"]} />
