<div data-wf-id="0b6b24bc-85cb-572d-3580-3b8c8cf9e103" data-w-id="0b6b24bc-85cb-572d-3580-3b8c8cf9e103" class="w-dyn-items resources-list 2-column">
{items1.map((item0) => (<div data-wf-id="0b6b24bc-85cb-572d-3580-3b8c8cf9e104" data-w-id="0b6b24bc-85cb-572d-3580-3b8c8cf9e104" class="w-dyn-item resources-item"><ElementBlogCard mainImage={item0.fields["main-image"]} linkTarget={linkTarget(evaluate(bindings[3], { data, Dynamo: item0.fields }))} link={linkUrl(evaluate(bindings[2], { data, Dynamo: item0.fields }))}>
<Fragment slot="resourcetypename">{item0.fields["resource-type-2.name"] ?? ""}</Fragment>
<Fragment slot="name">{item0.fields.name ?? ""}</Fragment>
</ElementBlogCard></div>))}
</div>
{!items1.length && (<div data-wf-id="0b6b24bc-85cb-572d-3580-3b8c8cf9e106" data-w-id="0b6b24bc-85cb-572d-3580-3b8c8cf9e106" class="w-dyn-empty">
