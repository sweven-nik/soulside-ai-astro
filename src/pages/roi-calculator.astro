---
import Layout from '@/layouts/Layout.astro';
import GlobalEmbeds from '@/components/1-globals/GlobalEmbeds.astro';
import GlobalAnnouncementBar from '@/components/1-globals/GlobalAnnouncementBar.astro';
import GlobalNavbar from '@/components/1-globals/GlobalNavbar.astro';
import Section from '@/components/2-sections/Section.astro';
import ElementContentGroup from '@/components/4-elements/ElementContentGroup.astro';
import GlobalDemoButton from '@/components/1-globals/GlobalDemoButton.astro';
import ElementRoiCalculator from '@/components/4-elements/ElementRoiCalculator.astro';
import GlobalFooter from '@/components/1-globals/GlobalFooter.astro';

const data = {};
const collectionData = {};


---
<Layout webflowPageId="6ac66bd1dac8eba02d4494b5" pageTitle="Behavioral Health Documentation ROI Calculator | Soulside" pageDescription="Estimate the hours and dollars your team could recover by automating clinical documentation with Soulside AI, broken out weekly, monthly, and annually." data-wf-id="60d3f7b8b0e86c28630fc6d6" data-w-id="60d3f7b8b0e86c28630fc6d6">
<div data-wf-id="d24e5ea8-78da-f5b7-6dab-ac39945b55b0" data-w-id="d24e5ea8-78da-f5b7-6dab-ac39945b55b0" class="page-wrapper">
<GlobalEmbeds />
<GlobalAnnouncementBar />
<GlobalNavbar />
<main data-wf-id="dcf94f42-feae-15fa-9712-17acf0a0a835" data-w-id="dcf94f42-feae-15fa-9712-17acf0a0a835" class="main-wrapper">
<Section>
<ElementContentGroup bodyRichTextFontSize="medium" bodyRichTextTag="p" headingStyle="h1" headingTag="h1" taglineVisibility={false} contentMaxWidth="large" contentAlignment="center">
<GlobalDemoButton />
<Fragment slot="bodyrichtext">Plug in your team’s numbers to see how many hours and dollars Soulside could return to patient care, broken out weekly, monthly, quarterly, and annually.</Fragment>
<Fragment slot="headingtext">ROI Calculator</Fragment>
</ElementContentGroup>
</Section>
<Section sectionColorScheme="lightest" sectionTopPadding="none">
<ElementRoiCalculator />
</Section>
</main>
<GlobalFooter />
</div>
</Layout>
