---
/**
 * Renders page builder blocks from Sanity with the real components. Props are passed through
 * as-is (unset props fall back to the component's own defaults) and slots are filled by kind.
 */
import { portableTextToHtml, portableTextToInlineHtml } from '@/lib/portable-text';
import { slotField } from './fields';
import { blockAttribute, type PreviewContext } from './preview-attributes';
import { registry } from './registry';
import WithAttribute from './WithAttribute.astro';

interface Props {
  blocks?: any[];
  /** Visual Editing preview only: where these blocks live in the document. */
  preview?: PreviewContext;
}
const { blocks = [], preview } = Astro.props;

// Path of a block inside the document, and the preview context for one of its child arrays.
const blockPath = (block: any) => (preview?.path && block?._key ? `${preview.path}[_key=="${block._key}"]` : undefined);
const childPreview = (block: any, field: string) => {
  const path = blockPath(block);
  return preview && path ? { ...preview, path: `${path}.${field}` } : undefined;
};
const fieldAttribute = (block: any, field: string) => {
  const path = blockPath(block);
  return preview && path ? blockAttribute(preview, `${path}.${field}`) : undefined;
};
const attr = (value: string) => value.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
/** Add an attribute to every top-level element of an HTML fragment (rich text blocks). */
function markTopLevel(html: string, value: string) {
  let depth = 0;
  return html.replace(/<(\/?)([a-zA-Z][\w-]*)([^>]*?)(\/?)>/g, (tag, close, name, rest, selfClose) => {
    const isVoid = selfClose || /^(br|img|hr|input|meta|link|source|wbr)$/i.test(name);
    if (close) { depth--; return tag; }
    const out = depth === 0 ? `<${name} data-sanity="${attr(value)}"${rest}${selfClose}>` : tag;
    if (!isVoid) depth++;
    return out;
  });
}
/** In the preview, make a text slot clickable without changing its text (no stega). */
function markText(html: string, kind: string, value: string | undefined) {
  if (!value || !html.trim()) return html;
  if (kind === 'rich') return markTopLevel(html, value);
  if (kind === 'string' || kind === 'inline') return `<span data-sanity="${attr(value)}">${html}</span>`;
  return html;
}
const attributeFor = (block: any) => {
  const path = blockPath(block);
  return preview && path ? blockAttribute(preview, path) : undefined;
};

const isEmpty = (value: unknown) => value == null || value === '' || (Array.isArray(value) && value.length === 0);

const items = blocks.map((block) => {
  const attribute = attributeFor(block);
  if (block?._type === 'htmlEmbed') return { kind: 'html' as const, html: block.code ?? '', attribute };
  if (block?._type === 'htmlWrapper') {
    const attrs = Object.fromEntries((block.attributes ?? []).filter((a: any) => a?.name).map((a: any) => [a.name, a.value ?? '']));
    return {
      kind: 'wrapper' as const,
      Tag: block.tag || 'div',
      attrs: { ...attrs, class: block.className || undefined, ...(attribute ? { 'data-sanity': attribute } : {}) },
      children: block.children ?? [],
      childPreview: childPreview(block, 'children'),
    };
  }
  const def = registry[block?._type];
  if (!def?.Component) {
    console.warn(`[page-builder] No component for block type "${block?._type}"`);
    return null;
  }
  const props: Record<string, unknown> = {};
  for (const prop of def.props) {
    const value = block[prop.name];
    if (value != null) props[prop.name] = value;
  }
  const slots = def.slots
    .map((slot) => ({ ...slot, value: block[slotField(slot.name)] }))
    .filter((slot) => !isEmpty(slot.value))
    .map((slot) => ({ ...slot, field: fieldAttribute(block, slotField(slot.name)) }))
    .map((slot) => ({
      name: slot.name === 'default' ? undefined : slot.name,
      blocks: slot.kind === 'blocks' ? slot.value : undefined,
      preview: slot.kind === 'blocks' ? childPreview(block, slotField(slot.name)) : undefined,
      html:
        slot.kind === 'blocks'
          ? undefined
          : markText(
              slot.kind === 'rich'
                ? portableTextToHtml(slot.value)
                : slot.kind === 'inline'
                  ? portableTextToInlineHtml(slot.value)
                  : slot.kind === 'svg'
                    ? String(slot.value)
                    : escape(String(slot.value)),
              slot.kind,
              slot.field,
            ),
    }));
  return { kind: 'component' as const, Component: def.Component, props, slots, attribute };
});

function escape(text: string) {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
---
{items.map((item) =>
  !item ? null : item.kind === 'html' ? (
    item.attribute ? <WithAttribute name="data-sanity" value={item.attribute}><Fragment set:html={item.html} /></WithAttribute> : <Fragment set:html={item.html} />
  ) : item.kind === 'wrapper' ? (
    <item.Tag {...item.attrs}><Astro.self blocks={item.children} preview={item.childPreview} /></item.Tag>
  ) : item.attribute ? (
    <WithAttribute name="data-sanity" value={item.attribute}>
      <item.Component {...item.props}>
        {item.slots.map((slot) =>
          slot.blocks ? (
            slot.name ? <Fragment slot={slot.name}><Astro.self blocks={slot.blocks} preview={slot.preview} /></Fragment> : <Astro.self blocks={slot.blocks} preview={slot.preview} />
          ) : slot.name ? (
            <Fragment slot={slot.name} set:html={slot.html} />
          ) : (
            <Fragment set:html={slot.html} />
          ),
        )}
      </item.Component>
    </WithAttribute>
  ) : (
    <item.Component {...item.props}>
      {item.slots.map((slot) =>
        slot.blocks ? (
          slot.name ? <Fragment slot={slot.name}><Astro.self blocks={slot.blocks} /></Fragment> : <Astro.self blocks={slot.blocks} />
        ) : slot.name ? (
          <Fragment slot={slot.name} set:html={slot.html} />
        ) : (
          <Fragment set:html={slot.html} />
        ),
      )}
    </item.Component>
  ),
)}
