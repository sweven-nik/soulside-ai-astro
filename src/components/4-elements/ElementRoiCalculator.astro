<div data-wf-id="b78f703c-8345-e125-20a3-71cee0e82dde" data-w-id="b78f703c-8345-e125-20a3-71cee0e82dde" class="w-embed hide">

<script is:inline>
  const totalHour = 40 * 52; // 40 hours/week × 52 weeks
  const costPerLicense = 82;
  const DEBOUNCE_MS = 500;
  const estTimeReductionWithAi = 80;

  let clinicianCount = 0;
  let averageSalary = 0;
  let hoursSpentOnDocs = 0;

  const formatCurrency = (value) => {
  return `$${new Intl.NumberFormat('en-US', {
    notation: 'compact',
    maximumFractionDigits: 1,
  }).format(value)}`;
};

  const getValueMap = (
    clinicianCount,
    averageSalary,
    hoursSpentOnDocs
  ) => {
    const percentTimeSpentOnDocs = Math.floor(
      (hoursSpentOnDocs * 100) / 8
    );

    const annualDocHours =
      (totalHour * percentTimeSpentOnDocs) / 100;

    const annualSavedHours =
      (annualDocHours * estTimeReductionWithAi) / 100;

    const annualDocCost =
      (percentTimeSpentOnDocs * averageSalary) / 100;

    // Annual saving for one clinician
    const annualSaving =
      (annualSavedHours * averageSalary) / totalHour;

    // Total saving for all clinicians
    const totalAnnualSaving =
      annualSaving * clinicianCount;

    const totalProductCost =
      clinicianCount * costPerLicense;


    return {
      perHour: {
        selector: '#per-hour',
        value: `${Math.floor(averageSalary / totalHour)}`
      },

      estTimeSavedWithAi: {
        selector: '#est-hours-saved-with-ai',
        value: `${Math.floor(
          (hoursSpentOnDocs * estTimeReductionWithAi) / 100
        )}`
      },

      hrsAnnual: {
        selector: '.hrs-annual',
        value: `${Math.floor(annualDocHours)}`
      },

      hrsQuarterly: {
        selector: '.hrs-quarterly',
        value: `${Math.floor(annualDocHours / 4)}`
      },

      hrsMonthly: {
        selector: '.hrs-monthly',
        value: `${Math.floor(annualDocHours / 12)}`
      },

      hrsWeekly: {
        selector: '.hrs-weekly',
        value: `${Math.floor(annualDocHours / 52)}`
      },

      hrsSavedAnnual: {
        selector: '.hrs-saved-annual',
        value: `${Math.floor(annualSavedHours)}`
      },

      hrsSavedQuarterly: {
        selector: '.hrs-saved-quarterly',
        value: `${Math.floor(annualSavedHours / 4)}`
      },

      hrsSavedMonthly: {
        selector: '.hrs-saved-monthly',
        value: `${Math.floor(annualSavedHours / 12)}`
      },

      hrsSavedWeekly: {
        selector: '.hrs-saved-weekly',
        value: `${Math.floor(annualSavedHours / 52)}`
      },
costAnnual: {
  selector: '.cost-annual',
  value: formatCurrency(annualDocCost),
},

costQuarterly: {
  selector: '.cost-quarterly',
  value: formatCurrency(annualDocCost / 4),
},

costMonthly: {
  selector: '.cost-monthly',
  value: formatCurrency(annualDocCost / 12),
},

costWeekly: {
  selector: '.cost-weekly',
  value: formatCurrency(annualDocCost / 52),
},

savingAnnual: {
  selector: '.saving-annual',
  value: formatCurrency(totalAnnualSaving),
},

savingQuarterly: {
  selector: '.saving-quarterly',
  value: formatCurrency(totalAnnualSaving / 4),
},

savingMonthly: {
  selector: '.saving-monthly',
  value: formatCurrency(totalAnnualSaving / 12),
},

savingWeekly: {
  selector: '.saving-weekly',
  value: formatCurrency(totalAnnualSaving / 52),
},

      costPerLicense: {
        selector: '.cost-per-license',
        value: `$${costPerLicense}`
      },

      totalProductCost: {
        selector: '.total-product-cost',
        value: `$${Math.floor(totalProductCost)}`
      },

      rateOfReturn: {
        selector: '.rate-of-return',
        value: totalProductCost
          ? `${Math.floor(
              (totalAnnualSaving / totalProductCost) * 100
            )}%`
          : '0%'
      },

      totalAnnualSaving: {
        selector: '.total-annual-saving',
        value: `$${Math.floor(
          totalAnnualSaving - totalProductCost
        )}`
      }
    };
  };

  function updateAll(
    clinicianCount,
    averageSalary,
    hoursSpentOnDocs
  ) {
    const valueMap = getValueMap(
      Number(clinicianCount),
      Number(averageSalary),
      Number(hoursSpentOnDocs)
    );

    Object.values(valueMap).forEach(({ selector, value, input }) => {
      insertText(selector, value, input);
    });
  }

  function debounce(fn, delay = 300) {
    let timeout;

    return (...args) => {
      clearTimeout(timeout);

      timeout = setTimeout(() => {
        fn(...args);
      }, delay);
    };
  }

  const debouncedUpdateAll = debounce(
    updateAll,
    DEBOUNCE_MS
  );

  function insertText(selector, text, input) {
    const elements = document.querySelectorAll(selector);

    elements.forEach((element) => {
      if (input) {
        element.value = text;
      } else {
        element.textContent = text;
      }
    });
  }

  const clinicianCountInput =
    document.querySelector('#clinician-count');

  const averageSalaryInput =
    document.querySelector('#average-salary');

  const hoursSpendOnDocsInput =
    document.querySelector('#hours-spend-on-docs');

  clinicianCountInput?.addEventListener('input', (event) => {
    clinicianCount = Number(event.target.value) || 0;

    debouncedUpdateAll(
      clinicianCount,
      averageSalary,
      hoursSpentOnDocs
    );
  });

  averageSalaryInput?.addEventListener('input', (event) => {
    averageSalary = Number(event.target.value) || 0;

    debouncedUpdateAll(
      clinicianCount,
      averageSalary,
      hoursSpentOnDocs
    );
  });

  hoursSpendOnDocsInput?.addEventListener('input', (event) => {
    hoursSpentOnDocs = Number(event.target.value) || 0;

    debouncedUpdateAll(
      clinicianCount,
      averageSalary,
      hoursSpentOnDocs
    );
  });

  // Initial calculation
  updateAll(
    clinicianCount,
    averageSalary,
    hoursSpentOnDocs
  );
</script>
