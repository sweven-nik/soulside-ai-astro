<div data-wf-id="d9856f2c-4e15-89d3-e428-27230817ebf1" data-w-id="d9856f2c-4e15-89d3-e428-27230817ebf1" class="w-embed accordion-js">
<!-- Custom auto-height accordions -->
<script is:inline>
  document.addEventListener("click", (e) => {
    const toggle = e.target.closest('[sw-accordion="toggle"]');
    if (!toggle) return;

    // Don't toggle when clicking links, inputs, etc. inside a toggle card
    const interactive = e.target.closest("a, input, select, textarea, label, button");
    if (interactive && interactive !== toggle && toggle.contains(interactive)) return;

    // Component can wrap the toggle (old setup) or sit inside it (card setup)
    const component =
      toggle.closest('[sw-accordion="component"]') ||
      toggle.querySelector('[sw-accordion="component"]');
    if (!component) return;

    component.classList.toggle("w--open");
  });
</script>
