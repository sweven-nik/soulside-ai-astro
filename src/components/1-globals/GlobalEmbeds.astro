<div data-wf-id="f4ca3a0f-5f6d-6ac0-de49-2c9b89b00ad8" data-w-id="f4ca3a0f-5f6d-6ac0-de49-2c9b89b00ad8" class="w-embed auto-tabs-js">
<script is:inline>
(function () {
  function initAutoTabs() {
    const sections = document.querySelectorAll('[sw-auto-tab="section"]');
    if (!sections.length) return;

    sections.forEach((section) => {
      const component = section.querySelector('[sw-auto-tab="component"]');
      if (!component) return;

      const menu = component.querySelector('[sw-auto-tab="menu"]');
      const links = menu ? menu.querySelectorAll('[sw-auto-tab="link"]') : [];
      const panesWrapper = component.querySelector('[sw-auto-tab="panes"]');
      const panes = panesWrapper ? panesWrapper.querySelectorAll('[sw-auto-tab="pane"]') : [];
      if (!links.length || !panes.length) return;

      // Accepts "7" or "7s"
      const durationAttr = component.getAttribute('sw-auto-tab-time') || '7';
      const duration = parseFloat(durationAttr.replace('s', '')) || 7;

      let currentIndex = 0;
      let timer = null;
      let isInView = false;

      function clearProgress(link) {
        const progress = link.querySelector('[sw-auto-tab="progress"]');
        if (progress) {
          progress.style.transition = 'none';
          progress.style.transform = 'scaleX(0)';
          progress.offsetHeight; // force reflow so the animation restarts
        }
      }

      function animateProgress(link) {
        const progress = link.querySelector('[sw-auto-tab="progress"]');
        if (progress) {
          progress.style.transition = `transform ${duration}s linear`;
          progress.style.transform = 'scaleX(1)';
        }
      }

      function activateTab(index) {
        links.forEach((link, i) => {
          link.classList.toggle('is-active', i === index);
          link.setAttribute('aria-selected', i === index ? 'true' : 'false');
          clearProgress(link);
        });
        panes.forEach((pane, i) => {
          pane.classList.toggle('is-active', i === index);
        });
        if (isInView) animateProgress(links[index]);
        currentIndex = index;
      }

      function resetTimer() {
        clearTimeout(timer);
        if (isInView) {
          timer = setTimeout(nextTab, duration * 1000);
        }
      }

      function nextTab() {
        activateTab((currentIndex + 1) % links.length);
        resetTimer();
      }

      // Manual clicks
      links.forEach((link, index) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          activateTab(index);
          resetTimer();
        });
      });

      // Show the first tab immediately so nothing is blank before scrolling
      activateTab(0);

      // Only auto-rotate while the section is on screen
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              isInView = true;
              activateTab(currentIndex);
              resetTimer();
            } else {
              isInView = false;
              clearTimeout(timer);
              links.forEach((link) => clearProgress(link));
            }
          });
        },
        { threshold: 0.2 }
      );

      observer.observe(section);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAutoTabs);
  } else {
    initAutoTabs();
  }
})();
</script>
