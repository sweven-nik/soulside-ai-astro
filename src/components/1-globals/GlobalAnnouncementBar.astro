<div data-wf-id="a878b5e8-830c-65de-bf8f-c79b904c6f9c" data-w-id="a878b5e8-830c-65de-bf8f-c79b904c6f9c" class="w-embed hide">
<style is:inline>
  [sw-banner="element"] {
    display: none !important;
  }
</style>

<script is:inline>
(function () {
  var COOKIE_NAME = 'banner_closed';
  var HOURS = 24;

  function setCookie(name, value, hours) {
    document.cookie = name + '=' + value +
      '; max-age=' + (hours * 60 * 60) +
      '; path=/; SameSite=Lax';
  }

  function getCookie(name) {
    return document.cookie.split('; ').some(function (c) {
      return c.indexOf(name + '=') === 0;
    });
  }

  function initBanner() {
    var banner = document.querySelector('[sw-banner="element"]');
    if (!banner) return;

    // Closed within the expiry window: leave it hidden
    if (getCookie(COOKIE_NAME)) return;

    // Not closed: show it
    banner.style.setProperty('display', 'flex', 'important');

    var close = banner.querySelector('[sw-banner="close"]');
    if (!close) return;

    close.addEventListener('click', function (e) {
      e.preventDefault();
      banner.style.setProperty('display', 'none', 'important');
      setCookie(COOKIE_NAME, '1', HOURS);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBanner);
  } else {
    initBanner();
  }
})();
</script>
</div>
</div>
