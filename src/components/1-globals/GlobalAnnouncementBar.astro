{items1.map((item0) => (<div data-wf-id="80af3ad0-93ba-0178-5267-fe0a6d97bda7" data-w-id="80af3ad0-93ba-0178-5267-fe0a6d97bda7" class="w-dyn-item annc-banner-item"><div data-wf-id="c14f99f0-25cb-d2c6-060a-65f6e9242736" data-w-id="c14f99f0-25cb-d2c6-060a-65f6e9242736" class="annc-banner">
