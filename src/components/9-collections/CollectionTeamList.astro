  {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Variable", "val": ["DynamoGateway", "dynamoLinkToBasicLinkV2"]}, "arg": {"type": "Union", "val": {"tag": "This tab", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Union", "val": {"tag": "None", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Select", "val": {"from": {"type": "Variable", "val": "Dynamo"}, "prop": "linkedin-url"}}}},
  {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Variable", "val": ["DynamoGateway", "dynamoLinkToBasicLinkV2"]}, "arg": {"type": "Union", "val": {"tag": "This tab", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Union", "val": {"tag": "None", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Select", "val": {"from": {"type": "Variable", "val": "Dynamo"}, "prop": "linkedin-url"}}}},
  {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Variable", "val": ["DynamoGateway", "dynamoLinkToBasicLinkV2"]}, "arg": {"type": "Union", "val": {"tag": "This tab", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Union", "val": {"tag": "None", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Select", "val": {"from": {"type": "Variable", "val": "Dynamo"}, "prop": "linkedin-url"}}}},
  {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Variable", "val": ["DynamoGateway", "dynamoLinkToBasicLinkV2"]}, "arg": {"type": "Union", "val": {"tag": "This tab", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Union", "val": {"tag": "None", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Select", "val": {"from": {"type": "Variable", "val": "Dynamo"}, "prop": "linkedin-url"}}}},
  {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Variable", "val": ["DynamoGateway", "dynamoLinkToBasicLinkV2"]}, "arg": {"type": "Union", "val": {"tag": "This tab", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Union", "val": {"tag": "None", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Select", "val": {"from": {"type": "Variable", "val": "Dynamo"}, "prop": "linkedin-url"}}}},
  {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Call", "val": {"fun": {"type": "Variable", "val": ["DynamoGateway", "dynamoLinkToBasicLinkV2"]}, "arg": {"type": "Union", "val": {"tag": "This tab", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Union", "val": {"tag": "None", "value": {"type": "Record", "val": {}}}}}}, "arg": {"type": "Select", "val": {"from": {"type": "Variable", "val": "Dynamo"}, "prop": "linkedin-url"}}}}
];

interface Props {
  /** Group */
  group?: "leadership" | "advisors";
}
const { group: propGroup = "leadership" } = Astro.props;
if (!["leadership", "advisors"].includes(propGroup)) throw new Error("CollectionTeamList.group must be one of: leadership, advisors");

const data = {};
const collectionData = {};
const collections = {
  "team": (await getSortedCollection("team")).filter(entry => !entry.data.isDraft && !entry.data.isArchived).map(entry => ({id: entry.data._id ?? entry.id, fields: resolveAssetUrls({ ...entry.data, slug: entry.id, fullSlug: "/team/" + entry.id, ...Object.fromEntries(Object.entries(entry.data._imageAlts ?? {}).map(([key, alt]) => [key, { url: entry.data[key], alt }])) })}))
};
const items1 = [...collections["team"]].filter(entry => { const value0 = entry.fields?.["is-advisor"]; let expected0 = "true"; if (typeof value0 === 'boolean' && ['true', 'false'].includes(expected0)) expected0 = expected0 === 'true'; if (typeof value0 === 'number' && typeof expected0 === 'string' && expected0.trim() !== '' && Number.isFinite(Number(expected0))) expected0 = Number(expected0); return (value0 !== expected0); }).sort((a, b) => { const x = a.fields["sort-order"], y = b.fields["sort-order"]; return (x === y ? 0 : x == null ? -1 : y == null ? 1 : typeof x === 'number' && typeof y === 'number' ? x - y : String(x).localeCompare(String(y))) * 1; });
const items3 = [...collections["team"]].filter(entry => { const value0 = entry.fields?.["is-advisor"]; let expected0 = "true"; if (typeof value0 === 'boolean' && ['true', 'false'].includes(expected0)) expected0 = expected0 === 'true'; if (typeof value0 === 'number' && typeof expected0 === 'string' && expected0.trim() !== '' && Number.isFinite(Number(expected0))) expected0 = Number(expected0); return (value0 === expected0); }).sort((a, b) => { const x = a.fields["sort-order"], y = b.fields["sort-order"]; return (x === y ? 0 : x == null ? -1 : y == null ? 1 : typeof x === 'number' && typeof y === 'number' ? x - y : String(x).localeCompare(String(y))) * 1; });
---
{propGroup === "advisors" ? (
<div data-w-id="f9b14bd1-70ac-71cc-7ba4-1f488bc30313" class="w-dyn-list team-wrapper">
<div data-w-id="f9b14bd1-70ac-71cc-7ba4-1f488bc30314" class="w-dyn-items team-list">
{items3.map((item2) => (<div data-w-id="f9b14bd1-70ac-71cc-7ba4-1f488bc30315" class="w-dyn-item team-item"><ElementCard contentGap="tiny" bodyVisibility={false} variant="no-fill">
<div slot="cta" data-w-id="f9b14bd1-70ac-71cc-7ba4-1f488bc30318" class="team-card_title">
{item2.fields.title ?? ""}
</div>
<Fragment slot="cta">{hasValue(item2.fields["short-bio"]) && (<div data-w-id="e6f59830-af51-2345-b031-f2783f7d236e" class="team-card_bio">
{hasValue(item2.fields["short-bio"]) && (<p data-w-id="e6f59830-af51-2345-b031-f2783f7d236f" class="team-card_bio">
{item2.fields["short-bio"] ?? ""}
</p>)}
</div>)}</Fragment>
<ElementImage imageBorderRadius="small" imageAspectRatio="square-1x1" imageFile={item2.fields.headshot} />
<Fragment slot="headingtext">{item2.fields.name ?? ""}</Fragment>
</ElementCard>
<ElementAbsoluteLink target="_blank" linkText={item2.fields.name ?? ""} linkTarget={linkTarget(evaluate(bindings[7], { data, Dynamo: item2.fields }))} link={linkUrl(evaluate(bindings[6], { data, Dynamo: item2.fields }))} /></div>))}
</div>
{!items3.length && (<div data-w-id="f9b14bd1-70ac-71cc-7ba4-1f488bc3031a" class="w-dyn-empty">
<div data-w-id="f9b14bd1-70ac-71cc-7ba4-1f488bc3031b">
No items found.
</div>
</div>)}
</div>
) : (
<div data-w-id="e8186a82-e05e-18ab-66ac-07884ad26122" class="w-dyn-list team-wrapper">
<div data-w-id="e8186a82-e05e-18ab-66ac-07884ad26123" class="w-dyn-items team-list">
{items1.map((item0) => (<div data-w-id="e8186a82-e05e-18ab-66ac-07884ad26124" class="w-dyn-item team-item"><ElementCard contentGap="tiny" bodyVisibility={false} taglineVisibility={false} variant="no-fill">
<div slot="cta" data-w-id="18b06f1b-1ff9-36a7-86fd-e4550ee89cfc" class="team-card_title">
{item0.fields.title ?? ""}
</div>
<Fragment slot="cta">{hasValue(item0.fields["short-bio"]) && (<div data-w-id="395755da-5503-e774-2028-5a5ae48ab6aa" class="team-card_bio">
{hasValue(item0.fields["short-bio"]) && (<p data-w-id="0cd44272-6a96-98ac-a0e1-3c1ee58ac88b" class="team-card_bio">
{item0.fields["short-bio"] ?? ""}
</p>)}
</div>)}</Fragment>
<ElementImage imageBorderRadius="small" imageAspectRatio="square-1x1" imageFile={item0.fields.headshot} />
<Fragment slot="headingtext">{item0.fields.name ?? ""}</Fragment>
</ElementCard>
<ElementAbsoluteLink target="_blank" linkText={item0.fields.name ?? ""} linkTarget={linkTarget(evaluate(bindings[3], { data, Dynamo: item0.fields }))} link={linkUrl(evaluate(bindings[2], { data, Dynamo: item0.fields }))} /></div>))}
</div>
{!items1.length && (<div data-w-id="e8186a82-e05e-18ab-66ac-07884ad26125" class="w-dyn-empty">
<div data-w-id="e8186a82-e05e-18ab-66ac-07884ad26126">
No items found.
</div>
</div>)}
</div>
)}
