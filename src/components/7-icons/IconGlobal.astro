---
import NestSize from '@/components/6-utilities/NestSize.astro';
import NestColor from '@/components/6-utilities/NestColor.astro';

interface Props {
  /** Color */
  color?: "inherit" | "accent";
  /** Size */
  size?: "xxhuge" | "xhuge" | "huge" | "xxlarge" | "xlarge" | "large" | "medium" | "small" | "xsmall" | "xxsmall" | "tiny";
  /** Icon */
  icon?: "template" | "example";
}
const collectionData = {};
const {
  color: propColor = "inherit",
  size: propSize = "medium",
  icon: propIcon = "template"
} = Astro.props;
if (!["inherit", "accent"].includes(propColor)) throw new Error("IconGlobal.color must be one of: inherit, accent");
if (!["xxhuge", "xhuge", "huge", "xxlarge", "xlarge", "large", "medium", "small", "xsmall", "xxsmall", "tiny"].includes(propSize)) throw new Error("IconGlobal.size must be one of: xxhuge, xhuge, huge, xxlarge, xlarge, large, medium, small, xsmall, xxsmall, tiny");
if (!["template", "example"].includes(propIcon)) throw new Error("IconGlobal.icon must be one of: template, example");


