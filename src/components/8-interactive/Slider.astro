        return {
          track,
          container: track.parentElement,
          slides: Array.from(track.children).filter((el) => !el.matches(IGNORE)),
        };
      };

      const tag = (found) => {
        found.container.classList.add('swiper');
        found.container.setAttribute('data-swiper-box', '');

        for (let el = found.container.parentElement; el && el !== swiperEl; el = el.parentElement) {
          el.classList.remove('swiper-wrapper', 'swiper-slide');
          el.setAttribute('data-swiper-pass', '');
          if (el.getAttribute('role') === 'list') el.removeAttribute('role');
        }

        found.track.classList.add('swiper-wrapper');
        if (!found.track.getAttribute('role')) found.track.setAttribute('role', 'list');

        found.slides.forEach((slide) => {
          slide.classList.add('swiper-slide');
          if (!slide.getAttribute('role')) slide.setAttribute('role', 'listitem');
        });
      };

      const start = (found) => {
        if (typeof Swiper === 'undefined') return;

        const slides = found.slides;
        const bool = (name) => component.getAttribute(name) === 'true';
        const num = (name, fallback) => Number(component.getAttribute(name)) || fallback;

        const effect = component.getAttribute('data-swiper-effect') || 'slide';
        const autoplayEnabled = bool('data-autoplay');
        const loop = bool('data-loop') && slides.length > 2;

        const swiperConfig = {
          wrapperClass: 'swiper-wrapper',
          slideClass: 'swiper-slide',
          slidesPerView: 'auto',
          spaceBetween: 0,
          followFinger: bool('data-follow-finger'),
          loop,
          rewind: bool('data-rewind') && !loop,
          freeMode: bool('data-free-mode'),
          slideToClickedSlide: bool('data-slide-to-clicked'),
          centeredSlides: false,
          autoHeight: false,
          watchOverflow: true,
          speed: num('data-speed', 600),
          effect,
          mousewheel: {
            enabled: bool('data-mousewheel'),
            forceToAxis: true,
          },
          a11y: {
            enabled: true,
            slideRole: 'listitem',
          },
          keyboard: {
            enabled: true,
            onlyInViewport: true,
          },
          autoplay: autoplayEnabled
            ? {
                delay: num('data-autoplay-delay', 3000),
                disableOnInteraction: true,
                pauseOnMouseEnter: true,
              }
            : false,
          slideActiveClass: 'is-active',
        };

        if (effect === 'fade') {
          swiperConfig.slidesPerView = 1;
          swiperConfig.fadeEffect = { crossFade: true };
        }

        if (paginationEl) {
          swiperConfig.pagination = {
            el: paginationEl,
            bulletActiveClass: 'is-active',
            bulletClass: 'slider_bullet_item',
            bulletElement: 'button',
            clickable: true,
          };
        }

        if (nextButton && prevButton) {
          swiperConfig.navigation = {
            nextEl: nextButton,
            prevEl: prevButton,
          };
        }

        const swiper = new Swiper(found.container, swiperConfig);
        if (controlsEl) controlsEl.style.display = '';
        component.setAttribute('data-swiper-state', 'ready');

        if (!autoplayEnabled) return;

        swiper.autoplay.stop();
        const visible = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              swiper.autoplay.start();
              obs.disconnect();
            });
          },
          { threshold: 0.2 },
        );
        visible.observe(component);
      };

      let resolved = null;
      let inRange = false;
      let started = false;

      const tryStart = () => {
        if (started || !resolved || !inRange) return;
        started = true;
        tag(resolved);
        start(resolved);
      };

      const check = () => {
        const found = resolve();
        if (!found || !found.container || found.slides.length < 2) return false;
        resolved = found;
        return true;
      };

      if (!check()) {
        let giveUp;
        const watcher = new MutationObserver(() => {
          if (!check()) return;
          watcher.disconnect();
          clearTimeout(giveUp);
          tryStart();
        });
        watcher.observe(swiperEl, { childList: true, subtree: true });

        giveUp = setTimeout(() => {
          if (started) return;
          watcher.disconnect();
          const found = resolve();
          deactivate(found && found.slides.length ? 'single' : 'empty');
        }, 4000);
      }

      if (!('IntersectionObserver' in window)) {
        inRange = true;
        tryStart();
        return;
      }

      const near = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            obs.disconnect();
            inRange = true;
            tryStart();
          });
        },
        { rootMargin: '50% 0px 50% 0px', threshold: 0 },
      );
      near.observe(component);
    });
  })();
</script>
</div>
<NestSlideWidth slides={propStyleSlidesDesktop} />
<NestSlideWidth slides={propStyleSlidesTablet} />
<NestSlideWidth slides={propStyleSlidesMobileL} />
<NestSlideWidth slides={propStyleSlidesMobileP} />
</div>)}
