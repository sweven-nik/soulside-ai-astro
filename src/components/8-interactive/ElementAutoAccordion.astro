---
import UtilitySpacer from '@/components/6-utilities/UtilitySpacer.astro';
import ElementRichText from '@/components/4-elements/ElementRichText.astro';

interface Props {
  /** Element / Rich Text/Body Font Size */
  elementRichTextBodyFontSize?: "large" | "medium" | "regular" | "small" | "tiny";
  elementRichTextRichTextTag?: string;
  /** Visibility */
  visibility?: boolean;
}
const collectionData = {};
const {
  elementRichTextBodyFontSize: propElementRichTextBodyFontSize = "regular",
  elementRichTextRichTextTag: propElementRichTextRichTextTag = "p",
  visibility: propVisibility = true
} = Astro.props;
if (!["large", "medium", "regular", "small", "tiny"].includes(propElementRichTextBodyFontSize)) throw new Error("ElementAutoAccordion.elementRichTextBodyFontSize must be one of: large, medium, regular, small, tiny");
const propElementRichTextRichText = "Lorem ipsum diam quis enim lobortis scelerisque fermentum dui faucibus in ornare quam viverra orci sagittis eu volutpat odio facilisis.";
